# Server
PORT=8080
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/shazam

# Firebase authentication (Admin SDK service account)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Gemini (AI identification). Leave BASE_URL empty to use the
# default Google endpoint with your own API key.
AI_INTEGRATIONS_GEMINI_API_KEY=your-gemini-api-key
AI_INTEGRATIONS_GEMINI_BASE_URL=

# Stripe (payments)
STRIPE_SECRET_KEY=sk_test_...

# Set to "false" to enforce real auth/paywall in development
PREVIEW_MODE=
