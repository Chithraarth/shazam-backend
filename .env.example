# Server
PORT=8080
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/shazam

# Firebase authentication (Admin SDK service account)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Gemini (AI identification). Leave BASE_URL empty to use the
# default Google endpoint with your own API key.
AI_INTEGRATIONS_GEMINI_API_KEY=your-gemini-api-key
AI_INTEGRATIONS_GEMINI_BASE_URL=

# Google Play Billing (consumable scan packs). Service account must be granted
# access in Play Console → Users and permissions, with the Android
# Publisher API enabled in the linked Google Cloud project.
GOOGLE_PLAY_CLIENT_EMAIL=play-billing@your-project.iam.gserviceaccount.com
GOOGLE_PLAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
ANDROID_PACKAGE_NAME=com.videofy.app

# Apple In-App Purchase (App Store Server API). Create an In-App Purchase
# key in App Store Connect → Users and Access → Integrations.
# App Store Server Notifications V2 URL: https://<domain>/api/billing/apple-notifications
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
IOS_BUNDLE_ID=com.videofy.app

# TMDB (posters, cast photos, episodes, where to watch). A v3 API key or a
# v4 read access token from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Shared secret for the Pub/Sub push subscription URL, e.g.
# https://videofy.co.in/api/billing/rtdn?token=<this value>
RTDN_WEBHOOK_SECRET=

# Oldest app builds allowed to keep working; older ones are asked to update.
# Leave empty for no minimum.
MIN_ANDROID_VERSION_CODE=
MIN_IOS_BUILD=

# Set to "true" (development only) to skip auth and scan credits for
# requests that send no Firebase token. Ignored when NODE_ENV=production.
PREVIEW_MODE=
